# ====================================================
# Telegram Bot & Backend Konfiguratsiyasi
# ====================================================

# 1. Telegram Bot Token: @BotFather orqali olingan token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Telegram Kanal ID: Loyihalar tashlab boriladigan kanal
# Masalan: @sizning_kanalingiz yoki -1001234567890
# MUHIM: Botni kanalingizga ADMIN qilib qo'shing va "Post Messages" ruxsatini bering!
TELEGRAM_CHANNEL_ID=@haydarali_orders

# 3. Admin Telegram Chat ID (ixtiyoriy, bot sizga ham shaxsiy xabar yuborishi uchun)
TELEGRAM_ADMIN_CHAT_ID=

# 4. Backend porti (default: 8080)
PORT=8080

# 5. Portfolio sayti URL manzili
PORTFOLIO_URL=https://haydaraliakbarov.uz
DEVELOPER_NAME=Akbarov Haydarali
DEVELOPER_TG=@haydaraliakbarov
